<local:MyPageRight x:Class="PCL.PageToolsAi"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanChat}">
    <!-- 根为有界 Grid：设置卡折叠后，聊天区独占剩余高度，PanChat 是页面上唯一的滚动区，
         滚轮/滚动条/自动跟随全部落到它身上（此前 PanChat 嵌套在无界 StackPanel 中 ScrollableHeight 恒为 0） -->
    <Grid Margin="25,10,25,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- API 设置（折叠卡，矮窗口/内嵌时默认折叠，保证聊天区可见） -->
        <local:MyCard x:Name="CardSettings" Margin="0,0,0,15"
                      Title="{DynamicResource Tools.Ai.Setting.Title}" CanSwap="True">
            <Grid Margin="25,30,25,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource Tools.Ai.Setting.Endpoint}"
                           Style="{StaticResource BasedOnTextBlock}"
                           VerticalAlignment="Center" Margin="0,0,15,0" />
                <local:MyTextBox Grid.Row="0" Grid.Column="1" x:Name="TextEndpoint" Margin="0,0,0,12"
                                 HintText="https://api.deepseek.com/v1" />

                <TextBlock Grid.Row="1" Text="{DynamicResource Tools.Ai.Setting.ApiKey}"
                           Style="{StaticResource BasedOnTextBlock}"
                           VerticalAlignment="Center" Margin="0,0,15,0" />
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:MyTextBox x:Name="TextApiKey" HintText="sk-..." />
                    <local:MyButton x:Name="BtnShowKey" Grid.Column="1" Margin="8,0,0,0"
                                    VerticalAlignment="Stretch" Padding="10,0"
                                    Text="{DynamicResource Tools.Ai.Setting.ShowKey}"
                                    Click="BtnShowKey_Click" />
                </Grid>

                <TextBlock Grid.Row="2" Text="{DynamicResource Tools.Ai.Setting.Model}"
                           Style="{StaticResource BasedOnTextBlock}"
                           VerticalAlignment="Center" Margin="0,0,15,0" />
                <local:MyTextBox Grid.Row="2" Grid.Column="1" x:Name="TextModel" Margin="0,0,0,12"
                                 HintText="deepseek-chat" />

                <TextBlock Grid.Row="3" Text="{DynamicResource Tools.Ai.Setting.Diagnosis}"
                           ToolTip="{DynamicResource Tools.Ai.Setting.Diagnosis.ToolTip}"
                           Style="{StaticResource BasedOnTextBlock}"
                           VerticalAlignment="Center" Margin="0,0,15,0" />
                <local:MyCheckBox Grid.Row="3" Grid.Column="1" x:Name="CheckDiagnosis"
                                  ToolTip="{DynamicResource Tools.Ai.Setting.Diagnosis.ToolTip}"
                                  Margin="0,0,0,12" VerticalAlignment="Center" />

                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <local:MyButton x:Name="BtnTest" Margin="0,0,10,0" Height="28" Padding="10,0"
                                    Text="{DynamicResource Tools.Ai.Setting.Test}"
                                    Click="BtnTest_Click" />
                    <local:MyButton Height="28" Padding="10,0"
                                    Text="{DynamicResource Tools.Ai.Setting.Save}"
                                    Click="BtnSave_Click" />
                </StackPanel>
            </Grid>
        </local:MyCard>

        <!-- 聊天 -->
        <local:MyCard Grid.Row="1" Title="{DynamicResource Tools.Ai.Title}">
            <Grid Margin="25,30,25,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 会话工具栏 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <local:MyComboBox x:Name="ComboSessions" Width="220" Height="26"
                                      HintText="{DynamicResource Tools.Ai.History}"
                                      SelectionChanged="ComboSessions_SelectionChanged" />
                    <local:MyButton Margin="8,0,0,0" Height="26" Padding="10,0"
                                    Text="{DynamicResource Tools.Ai.NewChat}"
                                    Click="BtnNewChat_Click" />
                    <local:MyButton Margin="8,0,0,0" Height="26" Padding="10,0"
                                    Text="{DynamicResource Tools.Ai.Memory}"
                                    Click="BtnMemory_Click" />
                </StackPanel>

                <local:MyScrollViewer Grid.Row="1" x:Name="PanChat" Margin="0,0,0,12"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PanChatList" Margin="0,0,5,0" />
                </local:MyScrollViewer>

                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <local:MyTextBox x:Name="TextInput" Height="28"
                                     MaxHeight="120" Margin="0"
                                     AcceptsReturn="True" TextWrapping="NoWrap"
                                     HintText="{DynamicResource Tools.Ai.Input.Hint}"
                                     KeyDown="TextInput_KeyDown"
                                     TextChanged="TextInput_TextChanged" />
                    <TextBlock x:Name="TextTokenUsage" HorizontalAlignment="Right" VerticalAlignment="Top"
                               Margin="0,2,6,0" FontSize="11" Opacity="0.55"
                               Foreground="{StaticResource ColorBrushGray4}" />
                </Grid>

                <Grid Grid.Row="3">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <local:MyButton Margin="0,0,10,0" Height="28" Padding="10,0"
                                        Text="{DynamicResource Tools.Ai.Skill.Core}"
                                        ToolTip="{DynamicResource Tools.Ai.Skill.Core.ToolTip}"
                                        Click="BtnSkillCore_Click" />
                        <local:MyButton Margin="0,0,10,0" Height="28" Padding="10,0"
                                        Text="{DynamicResource Tools.Ai.Skill.Mod}"
                                        ToolTip="{DynamicResource Tools.Ai.Skill.Mod.ToolTip}"
                                        Click="BtnSkillMod_Click" />
                        <local:MyButton Height="28" Padding="10,0"
                                        Text="{DynamicResource Tools.Ai.Skill.Keybind}"
                                        ToolTip="{DynamicResource Tools.Ai.Skill.Keybind.ToolTip}"
                                        Click="BtnSkillKeybind_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <local:MyButton x:Name="BtnStop" Margin="0,0,10,0" Height="28" Padding="10,0"
                                        Visibility="Collapsed" ColorType="Red"
                                        Text="{DynamicResource Tools.Ai.Stop}"
                                        Click="BtnStop_Click" />
                        <local:MyButton x:Name="BtnSend" Height="28" Padding="10,0" ColorType="Highlight"
                                        Text="{DynamicResource Tools.Ai.Send}"
                                        Click="BtnSend_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </local:MyCard>
    </Grid>
</local:MyPageRight>
